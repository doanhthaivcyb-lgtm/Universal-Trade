# Copy file này thành .env và điền key thật. File .env KHÔNG được đẩy lên repo.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Chỉ dùng khi chạy MT5 thật/demo, điền trên máy chạy Windows có MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Bật giao dịch thật chỉ khi đồng thời: config.yaml allow_live=true VÀ giá trị này = true
LIVE_TRADING_ENABLED=false
